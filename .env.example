# Copy to .env and export before running the server, or let config/config.yaml
# provide the same defaults for local development.
# PWF_ prefix maps to config paths, __ separates nesting.

PWF_ENV=development
PWF_HTTP__ADDR=:8080
PWF_HTTP__REQUEST_TIMEOUT=15s
# Set exact origins when the admin frontend is hosted on a different origin.
PWF_HTTP__CORS_ORIGINS=
PWF_DATABASE__URL=postgres://pwf_app:pwf-app@localhost:5432/pwf?sslmode=disable
PWF_DATABASE__MIGRATE_URL=postgres://pwf:pwf@localhost:5432/pwf?sslmode=disable
PWF_DATABASE__WORKER_URL=postgres://pwf_worker:pwf-worker@localhost:5432/pwf?sslmode=disable
PWF_DATABASE__MAX_CONNS=20
PWF_DATABASE__MIN_CONNS=2

PWF_AUTH__JWT_SECRET=dev-only-change-me
PWF_AUTH__ACCESS_TTL=15m
PWF_AUTH__REFRESH_TTL=720h

PWF_STORAGE__DRIVER=minio
PWF_STORAGE__ENDPOINT=localhost:8500
PWF_STORAGE__ACCESS_KEY=pwf
PWF_STORAGE__SECRET_KEY=pwf-secret
PWF_STORAGE__BUCKET=pwf
PWF_STORAGE__USE_SSL=false
PWF_STORAGE__REGION=us-east-1
PWF_STORAGE__PUBLIC_BASE_URL=http://localhost:8500/pwf

PWF_WORKER__ID=worker-local
PWF_WORKER__POLL_INTERVAL=2s
PWF_WORKER__BATCH_SIZE=10

PWF_ESIGN__PROVIDER=sandbox
PWF_ESIGN__CALLBACK_SECRET=dev-only-esign-secret-change-me
PWF_ESIGN__SIGN_BASE_URL=http://localhost:8080/sign
PWF_ESIGN__CALLBACK_TOLERANCE=5m

PWF_PAYMENT__PROVIDER=sandbox
PWF_PAYMENT__CALLBACK_SECRET=dev-only-payment-secret-change-me
PWF_PAYMENT__MERCHANT_ID=sandbox-merchant-001
PWF_PAYMENT__PAY_BASE_URL=http://localhost:8080/pay
PWF_PAYMENT__CALLBACK_TOLERANCE=5m
PWF_PAYMENT__ORDER_TTL=30m

# Optional alert webhook. Empty URL keeps alerts database-only.
PWF_ALERTS__WEBHOOK_URL=
PWF_ALERTS__WEBHOOK_SECRET=dev-only-alerts-secret-change-me
PWF_ALERTS__WEBHOOK_TIMEOUT=10s

# Invoicing adapter. manual requires operators to enter the numbers from the
# tax system; unknown providers refuse to boot.
PWF_INVOICE__PROVIDER=manual

# Scheduling: availability rules and hold expiry use this zone. Hold TTL is how
# long a booking reserves resources before the worker releases them.
PWF_SCHEDULE__TIMEZONE=Asia/Shanghai
PWF_SCHEDULE__HOLD_TTL=30m

# Shoot reminders: in-app notifications always record; the signed webhook is
# optional. Leads are comma-separated durations before the shoot. A zero auth
# or hold lead disables that reminder type.
PWF_REMINDERS__ENABLED=true
PWF_REMINDERS__SHOOT_LEADS=24h,2h
PWF_REMINDERS__AUTH_LEAD=24h
PWF_REMINDERS__HOLD_LEAD=10m
PWF_REMINDERS__WEBHOOK_URL=
PWF_REMINDERS__WEBHOOK_SECRET=dev-only-reminders-secret-change-me
PWF_REMINDERS__WEBHOOK_TIMEOUT=10s

# Windows capture agent contract. Heartbeats echo min_version so older agents
# prompt for an upgrade; empty disables the check.
PWF_AGENT__MIN_VERSION=

# Customer selection galleries (M5). Preview images only travel as signed URLs;
# presign_ttl bounds how long a leaked URL stays usable. public_base_url is the
# customer H5 origin used to build share links (https required in production);
# Empty watermark_text defaults to Lumeo; watermark_font must cover custom text.
PWF_GALLERY__PRESIGN_TTL=15m
PWF_GALLERY__SESSION_TTL=2h
PWF_GALLERY__SELECTION_BATCH=200
PWF_GALLERY__MAX_ASSETS=5000
PWF_GALLERY__WATERMARK_TEXT=
PWF_GALLERY__WATERMARK_FONT=
PWF_GALLERY__REMINDER_LEAD=24h
PWF_GALLERY__PUBLIC_BASE_URL=http://localhost:5174

# Proof rounds (M6). Proof links are independent of the selection deadline;
# token_grace extends a round token past due_at. annotation_max_bytes is the
# normalised annotation payload cap.
PWF_PROOF__SESSION_TTL=4h
PWF_PROOF__TOKEN_GRACE=168h
PWF_PROOF__MAX_ASSETS=500
PWF_PROOF__ANNOTATION_MAX_BYTES=16384

# Retouch integration. manual uploads in the admin app; folder_watch exchanges
# files through root/{outgoing,incoming}. ftp/pixcake/xiangxiang refuse to boot.
PWF_INTEGRATIONS__PROVIDER=manual
PWF_INTEGRATIONS__FOLDER_WATCH__ROOT=
PWF_INTEGRATIONS__FOLDER_WATCH__POLL_INTERVAL=30s
PWF_INTEGRATIONS__FOLDER_WATCH__OVERDUE_AFTER=72h

# Customer notifications. Email carries one-time proof links; production
# requires enabled with starttls or tls. SMS only supports the sandbox recorder.
PWF_NOTIFY__EMAIL__ENABLED=false
PWF_NOTIFY__EMAIL__HOST=
PWF_NOTIFY__EMAIL__PORT=587
PWF_NOTIFY__EMAIL__USERNAME=
PWF_NOTIFY__EMAIL__PASSWORD=
PWF_NOTIFY__EMAIL__FROM=
PWF_NOTIFY__EMAIL__TLS=starttls
PWF_NOTIFY__EMAIL__TIMEOUT=20s
PWF_NOTIFY__SMS__PROVIDER=

# Delivery downloads (M7). public_base_url falls back to
# gallery.public_base_url when empty. Sessions are short-lived; token TTLs are
# bounded by max_token_ttl. Packages are signed with presign_ttl.
PWF_DELIVERY__PUBLIC_BASE_URL=
PWF_DELIVERY__SESSION_TTL=30m
PWF_DELIVERY__DEFAULT_TOKEN_TTL=336h
PWF_DELIVERY__MAX_TOKEN_TTL=720h
PWF_DELIVERY__PRESIGN_TTL=5m
PWF_DELIVERY__MAX_DOWNLOADS=20
PWF_DELIVERY__MAX_ASSETS=300
PWF_DELIVERY__TEMP_DIR=
PWF_DELIVERY__WEB_EDGE=2048
PWF_DELIVERY__REQUIRE_WEB_SPEC=false

# Archive verification and retention (M7). The worker verifies every object by
# SHA-256 and warns before retention_until; it never deletes automatically.
PWF_ARCHIVE__SWEEP_INTERVAL=5m
PWF_ARCHIVE__DEFAULT_KEEP_DAYS=365
PWF_ARCHIVE__DEFAULT_WARN_DAYS=30

# Public Lumeo website inquiry intake. Set a real tenant UUID and exact origins.
PWF_PUBLIC_LEADS__TENANT_ID=
PWF_PUBLIC_LEADS__ORIGINS=

# WeChat Mini Program customer portal. Dev login only accepts dev:* identities
# and is rejected when PWF_ENV=production.
PWF_CUSTOMER__WECHAT_APP_ID=
PWF_CUSTOMER__WECHAT_APP_SECRET=
PWF_CUSTOMER__DEV_LOGIN=false
PWF_CUSTOMER__ACCESS_TTL=2h
PWF_CUSTOMER__REFRESH_TTL=720h
PWF_CUSTOMER__PUBLIC_BASE_URL=http://localhost:5173
